                  "const body = pm.response.json();",
                  "pm.test(\"All prices within 4000-6000\", () => body.forEach(h => pm.expect(h.price).to.be.within(4000, 6000)));",
                  "pm.test(\"Returns Lemon Tree, Holtin, Radison\", () => pm.expect(body.map(h => h.name)).to.have.members([\"Lemon Tree\",\"Holtin\",\"Radison\"]));"
                ]
              }
            }
          ],
