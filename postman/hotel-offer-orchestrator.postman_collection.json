{
  "info": {
    "name": "Hotel Offer Orchestrator",
    "description": "Tests for GET /api/hotels (Temporal + Redis). Run the folders in order with the Collection Runner; the last folder simulates supplier outages and restores them at the end.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "1. Happy path",
      "item": [
        {
          "name": "Delhi - de-duplicated best offers",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Response is a non-empty array\", () => { pm.expect(body).to.be.an(\"array\").that.is.not.empty; });",
                  "pm.test(\"Names are unique (de-duplicated)\", () => { const n = body.map(h => h.name.toLowerCase()); pm.expect(new Set(n).size).to.eql(n.length); });",
                  "pm.test(\"Each item has name, price, supplier, commissionPct\", () => body.forEach(h => pm.expect(h).to.have.all.keys(\"name\",\"price\",\"supplier\",\"commissionPct\")));",
                  "pm.test(\"Holtin -> Supplier B @ 5340 (cheaper)\", () => { const h = body.find(x => x.name === \"Holtin\"); pm.expect(h).to.include({price: 5340, supplier: \"Supplier B\", commissionPct: 20}); });",
                  "pm.test(\"Radison -> Supplier A @ 5900 (cheaper)\", () => { const h = body.find(x => x.name === \"Radison\"); pm.expect(h).to.include({price: 5900, supplier: \"Supplier A\", commissionPct: 13}); });",
                  "pm.test(\"Single-supplier hotels are kept\", () => { pm.expect(body.find(x => x.name === \"Ibis\").supplier).to.eql(\"Supplier A\"); pm.expect(body.find(x => x.name === \"The Oberoi\").supplier).to.eql(\"Supplier B\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hotels"
              ],
              "query": [
                {
                  "key": "city",
                  "value": "delhi"
                }
              ]
            },
            "description": ""
          }
        },
        {
